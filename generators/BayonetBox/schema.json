{
 "title": "BayonetBox",
 "desc": "Round box made from layers with twist on top",
 "groups": [
  {
   "title": "BayonetBox Settings",
   "items": [
    {
     "name": "diameter",
     "label": "diameter",
     "desc": "Diameter of the box in mm",
     "type": "text",
     "default": "50.0"
    },
    {
     "name": "lugs",
     "label": "lugs",
     "desc": "number of locking lugs",
     "type": "text",
     "default": "10"
    },
    {
     "name": "alignment_pins",
     "label": "alignment_pins",
     "desc": "diameter of the alignment pins",
     "type": "text",
     "default": "1.0"
    },
    {
     "name": "outside",
     "label": "outside",
     "desc": "treat sizes as outside measurements",
     "type": "bool",
     "default": true
    }
   ]
  },
  {
   "title": "Default Settings",
   "items": [
    {
     "name": "thickness",
     "label": "thickness",
     "desc": "thickness of the material (in mm)",
     "type": "text",
     "default": "3.0"
    },
    {
     "name": "burn",
     "label": "burn",
     "desc": "burn correction (in mm)(bigger values for tighter fit)",
     "type": "text",
     "default": "0.1"
    },
    {
     "name": "format",
     "label": "format",
     "desc": "format of resulting file",
     "type": "select",
     "options": [
      [
       "dxf",
       "dxf"
      ],
      [
       "gcode",
       "gcode"
      ],
      [
       "lbrn2",
       "lbrn2"
      ],
      [
       "pdf",
       "pdf"
      ],
      [
       "plt",
       "plt"
      ],
      [
       "ps",
       "ps"
      ],
      [
       "svg",
       "svg"
      ],
      [
       "svg_Ponoko",
       "svg_Ponoko"
      ]
     ],
     "default": "svg"
    },
    {
     "name": "labels",
     "label": "labels",
     "desc": "label the parts (where available)",
     "type": "bool",
     "default": true
    },
    {
     "name": "reference",
     "label": "reference",
     "desc": "print reference rectangle with given length (in mm)(zero to disable)",
     "type": "text",
     "default": "100.0"
    },
    {
     "name": "tabs",
     "label": "tabs",
     "desc": "width of tabs holding the parts in place (in mm)(not supported everywhere)",
     "type": "text",
     "default": "0.0"
    },
    {
     "name": "qr_code",
     "label": "qr_code",
     "desc": "Add a QR Code with link or command line to the generated output",
     "type": "bool",
     "default": false
    },
    {
     "name": "inner_corners",
     "label": "inner_corners",
     "desc": "style for inner corners",
     "type": "select",
     "options": [
      [
       "loop",
       "loop"
      ],
      [
       "corner",
       "corner"
      ],
      [
       "backarc",
       "backarc"
      ]
     ],
     "default": "loop"
    },
    {
     "name": "spacing",
     "label": "spacing",
     "desc": "spacing around parts (multiples of thickness [: extra space in mm])",
     "type": "text",
     "default": "0.5"
    },
    {
     "name": "debug",
     "label": "debug",
     "desc": "print surrounding boxes for some structures",
     "type": "bool",
     "default": false
    }
   ]
  }
 ]
}
